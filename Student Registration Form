def search():
    tx = Search.get()
    Clear()
    saveButton.config(state='disable')
    cursor.execute("SELECT * FROM students WHERE registration_no = %s", (tx,))
    result = cursor.fetchone()
    if result:
        Registration.set(result[0])
        Name.set(result[1])
        Class.set(result[2])
        if result[3] == 'Female':
            R2.select()
        else:
            R1.select()
        DOB.set(result[4])
        Date.set(result[5])
        Religion.set(result[6])
        Skill.set(result[7])
        F_name.set(result[8])
        M_name.set(result[9])
        Father_Occupation.set(result[10])
        Mother_Occupation.set(result[11])
        if result[12]:
            profile_image = base64.b64decode(result[12])
            with open("temp_image.jpg", "wb") as temp_image:
                temp_image.write(profile_image)
            img = Image.open("temp_image.jpg")
            resized_image = img.resize((190, 190))
            photo2 = ImageTk.PhotoImage(resized_image)
            lbl.config(image=photo2)
            lbl.image = photo2
    else:
        messagebox.showerror("Invalid", "Invalid registration number!")

