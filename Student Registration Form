    cursor.execute("""
        UPDATE students SET name=%s, class=%s, gender=%s, dob=%s,
        registration_date=%s, religion=%s, skill=%s, father_name=%s,
        mother_name=%s, father_occupation=%s, mother_occupation=%s,
